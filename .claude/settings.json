{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "dontAsk",
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git clean -fd*)",
      "Bash(git rebase*)",
      "Bash(curl*loud=1*)",
      "Bash(curl*run=1*)",
      "Bash(curl*wallet-watch*)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(node --check:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm start:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(npm ls:*)",
      "Bash(npm root:*)",
      "Bash(curl -sI:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sha256sum:*)",
      "Bash(python3 -c:*)"
    ]
  }
}
