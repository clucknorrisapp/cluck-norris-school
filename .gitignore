# Dependencies
node_modules/
# ⚠️ The bare name too: `node_modules/` matches a DIRECTORY only, so a node_modules SYMLINK (a
# worktree pointing at the main checkout's install) slipped past it into a commit on 2026-09-21
# — an absolute link to one machine's path, tracked in git (Codex on PR #390). Never again.
node_modules

# Build output
dist/
dist-store-*/
release/

# `npm pack`/`npm publish` dry-run artifacts (packages/hub-verify, DD1) — never committed
*.tgz

# Generated by `npm run build:hubverify` (vite.hubverify.config.js) — written into public/ so the
# server's explicit route can read it straight off disk, never committed; server.js 404s with a
# clear message when it's absent (a no-build boot).
public/hub-verify.bundle.js

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.local
.env.*.local

# Internal docs — keep strategy/brainstorm notes out of the public repo
STRATEGY.md
SECURITY-BACKLOG.md

# Local Claude Code config (machine-specific, keep private) — but DO commit skills,
# so fresh cloud sessions get our reusable workflows (.claude/skills/), and DO commit
# settings.json: this container resets often and wipes anything not in git, so the
# permission config has to live in the repo to survive. settings.local.json stays
# ignored by the .claude/* rule above for genuinely machine-specific overrides. Also DO commit
# agents/ (subagent seat definitions), commands/ (slash-command runbooks), rules/ (path-scoped
# traps split out of AGENTS.md) and hooks/ (the no-mutating-get PreToolUse guard) — 2026-09-23,
# docs/OPERATING_MODEL.md "Claude Code scaffolding" — same reason as skills/: a fresh container
# needs them from git, not from a machine that just got wiped.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/rules/
!.claude/hooks/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Normie Quest instrumented test build (dev-only, generated by build.js --test)
.nq_test.html

# transient verification scripts (headless render checks) — never part of the app
k.cjs
_*.cjs
probe.cjs

# nq-visual regression gate: diff images written ONLY on a failing run, for local inspection.
# The baselines/ dir IS committed (it's the source of truth); the diffs/ dir is throwaway.
normie-quest/test/visual-diffs/
dist-seeker/
