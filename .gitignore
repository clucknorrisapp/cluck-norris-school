# Dependencies
node_modules/

# Build output
dist/

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.local
.env.*.local

# Internal docs — keep strategy/brainstorm notes out of the public repo
STRATEGY.md
SECURITY-BACKLOG.md

# Local Claude Code config (machine-specific, keep private) — but DO commit skills,
# so fresh cloud sessions get our reusable workflows (.claude/skills/), and DO commit
# settings.json: this container resets often and wipes anything not in git, so the
# permission config has to live in the repo to survive. settings.local.json stays
# ignored by the .claude/* rule above for genuinely machine-specific overrides.
.claude/*
!.claude/skills/
!.claude/settings.json

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Normie Quest instrumented test build (dev-only, generated by build.js --test)
.nq_test.html

# transient verification scripts (headless render checks) — never part of the app
k.cjs
_*.cjs
probe.cjs
